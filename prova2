def q1():
        
    
        
        #executar em loop
        print(80*"*")
        print('Bem vindo ao Banco Guaraní')
        print(80*"*")
        print()
        print('Para sair da aplicação escreva: "Sair"')
    
    
    
        conta_corrente = ''
        
        while conta_corrente != 'Sair':
            
            conta_corrente = input('Digite o código da conta corrente:')
            if conta_corrente == 'Sair':break 
        
            try:
                if len(conta_corrente) != 5:
                    print('Quantidade errada de elementos da conta corrente')
                    continue
                
                # print(f'Teste inverso contacorrente: {conta_corrente[::-1]}')
                soma_com_inverso = int(conta_corrente) + int(conta_corrente[::-1])
                # print(soma_com_inverso)
        
                posição = 1
                operação_b = 0
                
                for i in str(soma_com_inverso):
                    operação_b += int(i) * posição
                    posição +=1
                    # print(operação_b)
                
                digito_verificador = str(operação_b)[1]
                print()
                print(f'O número da sua conta com dígito verificador é {conta_corrente}-{digito_verificador}')
                print()
                print('Muito obrigado e até a próxima!')
                print(80*"*")
        
                break
            
            except ValueError:
                print('Não é um valor númerico')
                continue
    
